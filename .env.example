# RAI environment example. Copy locally and replace placeholders; never commit real secrets.

NODE_ENV=production
HOST=127.0.0.1
PORT=3009
TRUST_PROXY=loopback
PUBLIC_BASE_URL=https://rai.rick.sarl
CORS_ORIGINS=https://rai.rick.sarl,https://rai.000339.xyz,https://rai.rick.quest
ZTX6D_CALLBACK_URL=https://rai.rick.sarl/api/auth/ztx6d/callback
OPENROUTER_HTTP_REFERER=https://rai.rick.sarl
OPENROUTER_APP_TITLE=RAI

# Required secrets. Restricted 0600 files keep signing keys out of PM2 environment dumps.
JWT_SECRET_FILE=/rick/apps/rai/.jwt-secret
ADMIN_JWT_SECRET_FILE=/rick/apps/rai/.admin-jwt-secret
# Direct JWT_SECRET / ADMIN_JWT_SECRET values remain supported for non-production tests.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Production admin login requires TOTP by default.
RAI_ADMIN_TOTP_REQUIRED=true
ADMIN_TOTP_SECRET=replace-with-base32-totp-secret
RAI_TOTP_ENCRYPTION_KEY_FILE=/rick/apps/rai/.totp-encryption-key
RAI_REFRESH_TOKEN_PEPPER_FILE=/rick/apps/rai/.refresh-token-pepper
# During a TOTP key rotation, keep prior key material here only until every row is re-wrapped.
RAI_TOTP_PREVIOUS_ENCRYPTION_KEYS=
# Alternatively provide RAI_REFRESH_TOKEN_PEPPER directly (at least 32 random characters).
RAI_PASSWORD_BREACH_CHECK_ENABLED=true
RAI_PASSWORD_BREACH_CHECK_TIMEOUT_MS=2500
RAI_TOTP_ISSUER=RAI
RAI_PASSKEY_RP_NAME=RAI
RAI_PASSKEY_ALLOW_LOCALHOST=false
ADMIN_TOKEN_EXPIRES_IN=12h

# Email verification.
RESEND_API_KEY=replace-with-resend-api-key
# Must be a real sender address, for example: RAI <noreply@mail.rick.quest>
RESEND_FROM_EMAIL=RAI <noreply@example.com>
RESEND_API_URL=https://api.resend.com/emails
RAI_RESEND_TIMEOUT_MS=12000
RAI_ALLOW_RESEND_TEST_MODE_EMAIL_BYPASS=false

# Provider keys and endpoints.
# Optional OpenAI-compatible GPT chat and image gateways. Production requires
# HTTPS /v1 roots and regular, non-symlink 0600 key files; inline keys are not accepted.
RAI_GPT_GATEWAY_BASE_URL=https://gateway.example.com/v1
RAI_GPT_GATEWAY_API_KEY_FILE=/rick/apps/rai/.gpt-gateway-api-key
RAI_GPT_IMAGE_BASE_URL=https://image-gateway.example.com/v1
RAI_GPT_IMAGE_API_KEY_FILE=/rick/apps/rai/.gpt-image-api-key
RAI_FAST_GATEWAY_BASE_URL=https://fast.000339.xyz/v1
RAI_FAST_GATEWAY_API_KEY_FILE=/rick/apps/rai/.fast-gateway-api-key
RAI_CLAUDE_GATEWAY_BASE_URL=https://www.umapis.com/v1
RAI_CLAUDE_GATEWAY_API_KEY_FILE=/rick/apps/rai/.claude-gateway-api-key
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
GOOGLE_GEMINI_API_KEY=replace-with-gemini-key
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
SILICONFLOW_API_KEY=replace-with-siliconflow-key
SILICONFLOW_IMAGE_GENERATION_URL=https://api.siliconflow.cn/v1/images/generations
TAVILY_API_KEY=replace-with-tavily-key
DEEPSEEK_API_KEY=replace-with-deepseek-key

# Runtime policy.
RAI_GENERATED_IMAGE_ALLOWED_HOSTS=siliconflow.cn
RAI_GENERATED_IMAGE_FETCH_TIMEOUT_MS=8000
RAI_GENERATED_IMAGE_MAX_BYTES=20971520
RAI_GENERATED_IMAGE_TTL_DAYS=30
RAI_IMAGE_URL_HEAD_TIMEOUT_MS=2000
RAI_IMAGE_FETCH_MAX_REDIRECTS=3
RAI_CSP_ALLOW_LOCAL_CONNECT=false
# Optional comma-separated, exact HTTP(S) origins. The default is same-origin only.
RAI_CSP_CONNECT_ORIGINS=
RAI_RUNTIME_REPORT_PATH=/rick/apps/rai/rai运行报告.md
RAI_UPLOAD_MAX_FILE_MB=20
RAI_UPLOAD_USER_TOTAL_MB=500
RAI_UPLOAD_USER_MAX_FILES=300
RAI_UPLOAD_QUOTA_PER_MINUTE=6
# Keep this false in production until the parser runs with deterministic network isolation.
# Node versions before 25 do not deny network access through the Permission Model.
RAI_DOCUMENT_PARSER_ENABLED=false
RAI_DOCUMENT_PARSER_TIMEOUT_MS=12000
RAI_DOCUMENT_PARSER_MEMORY_MB=160
RAI_DOCUMENT_PARSER_CONCURRENCY=2
RAI_DOCUMENT_PARSER_QUEUE_LIMIT=8
RAI_MAX_CONCURRENT_REQUESTS_FREE=2
RAI_MAX_CONCURRENT_REQUESTS_PRO_MAX=5
RAI_CONVERSATION_SIGNING_PRIVATE_KEY_FILE=/path/to/ed25519-private.pem
RAI_CONVERSATION_INTEGRITY_ISSUER=https://rai.example.com
RAI_CONVERSATION_LEDGER_DIR=/var/lib/rai/conversation-integrity
RAI_CONVERSATION_BACKFILL_CONCURRENCY=4
# Configure only after this exact directory is a real pCloud mount.
# RAI_CONVERSATION_LEDGER_MIRROR_DIR=/mnt/pcloud/RAI/conversation-integrity
RAI_CHAT_QUOTA_PER_MINUTE=6
RAI_CHAT_QUOTA_PER_5H=120
RAI_CHAT_QUOTA_PER_WEEK=800

# Optional branding/runtime.
RAI_BRAND_NAME=RAI
RAI_BRAND_SHORT_NAME=RAI
RAI_BRAND_BADGE=
RAI_BRAND_TITLE=RAI
RAI_DEFAULT_DISABLED_MODELS=
RAI_DEFAULT_DOMAIN_NOTICE_ENABLED=true
RAI_DEFAULT_DOMAIN_NOTICE_URL=https://rai.rick.sarl/
RAI_LONG_MEMORY_DEFAULT_ENABLED=false
